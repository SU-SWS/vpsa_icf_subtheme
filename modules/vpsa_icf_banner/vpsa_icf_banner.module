<?php

/**
 * @file
 * Applies stanford_banner variant classes when the front-end theme is inactive.
 *
 * Stanford Sites uses Claro/Gin for node editing. Theme preprocess and
 * hook_ENTITY_TYPE_view_alter implementations in vpsa_icf_subtheme do not run
 * there, so Layout Paragraphs / paragraph widget previews never received
 * vicf-banner--* classes or the subtheme CSS. This module always runs.
 */

use Drupal\Core\Render\Element;
use Drupal\Core\Template\Attribute;
use Drupal\paragraphs\ParagraphInterface;

/**
 * Implements hook_ENTITY_TYPE_view_alter() for paragraph.
 */
function vpsa_icf_banner_paragraph_view_alter(array &$build, ParagraphInterface $paragraph, $display) {
  if ($paragraph->bundle() !== 'stanford_banner') {
    return;
  }

  $classes = vpsa_icf_banner_variant_classes($paragraph);
  if (!$classes) {
    return;
  }

  if (!isset($build['#attributes'])) {
    $build['#attributes'] = [];
  }
  vpsa_icf_banner_add_classes($build['#attributes'], $classes);

  $theme_handler = \Drupal::service('theme_handler');
  $active_theme = \Drupal::theme()->getActiveTheme()->getName();
  $default_theme = $theme_handler->getDefault();
  $using_admin_theme = ($active_theme !== $default_theme);

  // Widget / LP previews under Claro/Gin often render only the Jumpstart hero
  // (no paragraph attributes wrapper). Prefix gives CSS an ancestor; also load
  // the front-end theme CSS which the admin theme does not attach.
  if ($using_admin_theme) {
    $class_attr = htmlspecialchars(implode(' ', $classes), ENT_QUOTES, 'UTF-8');
    $build['#prefix'] = ($build['#prefix'] ?? '') . '<div class="' . $class_attr . '">';
    $build['#suffix'] = '</div>' . ($build['#suffix'] ?? '');

    if ($theme_handler->themeExists('vpsa_icf_subtheme')) {
      $build['#attached']['library'][] = 'vpsa_icf_subtheme/allpages';
    }
  }

  // Stamp classes onto nested hero components when they exist in the tree.
  $build['#vicf_banner_classes'] = $classes;
  $build['#pre_render'][] = 'vpsa_icf_banner_pre_render_inject_classes';
}

/**
 * Pre-render: inject variant classes into nested hero render elements.
 */
function vpsa_icf_banner_pre_render_inject_classes(array $element) {
  $classes = $element['#vicf_banner_classes'] ?? [];
  if ($classes) {
    vpsa_icf_banner_inject_hero_classes_recursive($element, $classes);
  }
  return $element;
}

/**
 * Recursively add banner classes to hero-like render children.
 */
function vpsa_icf_banner_inject_hero_classes_recursive(array &$element, array $classes) {
  $theme = (string) ($element['#theme'] ?? '');
  $type = (string) ($element['#type'] ?? '');
  $id = (string) ($element['#id'] ?? ($element['#pattern_id'] ?? ($element['#component'] ?? '')));
  $component = (string) ($element['#component_id'] ?? '');

  $is_hero = (
    strpos($theme, 'hero') !== FALSE
    || strpos($id, 'hero') !== FALSE
    || strpos($component, 'hero') !== FALSE
    || ($type === 'pattern' && strpos($id, 'hero') !== FALSE)
    || ($type === 'component' && strpos((string) ($element['#component'] ?? ''), 'hero') !== FALSE)
  );

  if ($is_hero) {
    vpsa_icf_banner_add_classes_to_bucket($element, '#attributes', $classes);
    vpsa_icf_banner_add_classes_to_bucket($element, '#wrapper_attributes', $classes);
    if (isset($element['#props']) && is_array($element['#props'])) {
      if (!isset($element['#props']['attributes'])) {
        $element['#props']['attributes'] = [];
      }
      vpsa_icf_banner_add_classes($element['#props']['attributes'], $classes);
    }
  }

  foreach (Element::children($element) as $key) {
    if (is_array($element[$key])) {
      vpsa_icf_banner_inject_hero_classes_recursive($element[$key], $classes);
    }
  }
}

/**
 * Collect banner variant + overlay classes from react_paragraphs behaviors.
 *
 * @return string[]
 */
function vpsa_icf_banner_variant_classes(ParagraphInterface $paragraph) {
  return array_values(array_filter([
    vpsa_icf_banner_behavior_setting($paragraph, 'banner_variant', 'vicf-banner--default'),
    vpsa_icf_banner_behavior_setting($paragraph, 'banner_overlay'),
  ]));
}

/**
 * Read a banner behavior setting, trying known react_paragraphs plugin IDs.
 */
function vpsa_icf_banner_behavior_setting(ParagraphInterface $paragraph, $key, $default = NULL) {
  $plugin_ids = [
    'react_paragraphs:banner_variant_info',
    'react_paragraphs:vpsa_icf_subtheme_banner_variant_info',
  ];

  foreach ($plugin_ids as $plugin_id) {
    $value = $paragraph->getBehaviorSetting($plugin_id, $key);
    if ($value !== NULL && $value !== '') {
      return $value;
    }
  }

  return $default;
}

/**
 * Add CSS classes to an attributes array or Attribute object.
 *
 * @param array|\Drupal\Core\Template\Attribute $attributes
 *   Attributes, passed by reference.
 * @param string[] $classes
 *   Classes to add.
 */
function vpsa_icf_banner_add_classes(&$attributes, array $classes) {
  if ($attributes instanceof Attribute) {
    $attributes->addClass($classes);
    return;
  }

  if (!is_array($attributes)) {
    return;
  }

  $existing = $attributes['class'] ?? [];
  if (!is_array($existing)) {
    $existing = $existing ? [$existing] : [];
  }

  $attributes['class'] = array_values(array_unique(array_merge($existing, $classes)));
}

/**
 * Add CSS classes to a render-array attribute property.
 */
function vpsa_icf_banner_add_classes_to_bucket(array &$element, $key, array $classes) {
  if (!isset($element[$key])) {
    $element[$key] = [];
  }
  vpsa_icf_banner_add_classes($element[$key], $classes);
}
