<?php

/**
 * @file
 * Preprocess functions for VPSA ICF Subtheme.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;

/**
 * Prepares variables for the html.html.twig template.
 */
function vpsa_icf_subtheme_preprocess_html(&$variables) {
  $variables['stanford_basic_path'] = \Drupal::service('extension.list.theme')->getPath('stanford_basic');
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
function vpsa_icf_subtheme_theme_suggestions_block_alter(array &$suggestions, array $variables) {
  if (!empty($variables['elements']['#id']) && $variables['elements']['#id'] == 'vpsa_icf_subtheme_search') {
    $suggestions[] = 'block__stanford_basic_search';
  }
}

/**
 * Implements hook_form_alter().
 *
 * Move react banner variant behaviors above other behavior plugins in the UI.
 * Layout Paragraphs builds behavior plugin children in a #process callback, so
 * weights are applied in #after_build after those children exist.
 */
function vpsa_icf_subtheme_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  if (empty($form['behavior_plugins'])) {
    return;
  }

  $form['behavior_plugins']['#after_build'][] = 'vpsa_icf_subtheme_behavior_plugins_after_build';
}

/**
 * After-build callback to prioritize banner variant behavior fields.
 */
function vpsa_icf_subtheme_behavior_plugins_after_build(array $element, FormStateInterface $form_state) {
  foreach (Element::children($element) as $plugin_id) {
    if (strpos($plugin_id, 'banner_variant_info') !== FALSE) {
      $element[$plugin_id]['#weight'] = -100;
    }
  }

  return $element;
}

/**
 * Implements hook_preprocess_HOOK() for ds_entity_view.
 */
function vpsa_icf_subtheme_preprocess_ds_entity_view(&$variables) {
  // If not running on a paragraph, exit out.
  if (!isset($variables['content']['#paragraph'])) {
    return;
  }

  $paragraph = $variables['content']['#paragraph'];

  // Process Banners.
  if ($paragraph->bundle() == 'stanford_banner') {
    vpsa_icf_subtheme_preprocess_banner($variables);
  }
}

/**
 * Prepares variables for stanford_banner paragraphs.
 */
function vpsa_icf_subtheme_preprocess_banner(&$variables) {
  $paragraph = $variables['content']['#paragraph'];

  $existing_classes = $variables['attributes']['class'] ?? [];
  $extra_classes = array_filter([
    $paragraph->getBehaviorSetting('react_paragraphs:banner_variant_info', 'banner_variant', 'vicf-banner--default'),
    $paragraph->getBehaviorSetting('react_paragraphs:banner_variant_info', 'banner_overlay'),
  ]);

  // Add variant classes to banner.
  $variables['attributes']['class'] = array_merge($existing_classes, $extra_classes);
}
